# ---- Server ----
PORT=4000
# Public URL of this API (used to build links to locally stored uploads)
PUBLIC_API_URL=http://localhost:4000
# Comma-separated list of frontend origins allowed by CORS
FRONTEND_URL=http://localhost:3100

# ---- Database (PostgreSQL) ----
# Local docker-compose database. For Neon use the connection string they give you (with ?sslmode=require)
DATABASE_URL=postgresql://homevault:homevault@localhost:5434/homevault?schema=public

# ---- Auth ----
# Use a long random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d


# ---- File storage (optional) ----
# Leave empty to store uploads on local disk (./uploads).
# On Render's free tier the disk is wiped on restart, so set this for production:
# cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
