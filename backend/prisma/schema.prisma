// HomeVault data model.
// Every record belongs to a Household; all API queries are scoped by householdId.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum Plan {
  FREE
  ESSENTIAL
  FAMILY
  PRO
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model Household {
  id          String    @id @default(cuid())
  name        String
  plan        Plan      @default(FAMILY)
  trialEndsAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  users            User[]
  documents        Document[]
  tasks            Task[]
  events           Event[]
  contacts         Contact[]
  assets           Asset[]
  receipts         Receipt[]
  emergencyEntries EmergencyEntry[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(MEMBER)
  householdId  String
  household    Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  assignedTasks Task[]
}

model Document {
  id              String    @id @default(cuid())
  householdId     String
  household       Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  title           String
  category        String    @default("OTHER")
  notes           String?
  fileUrl         String?
  fileName        String?
  mimeType        String?
  expiresAt       DateTime?
  includeInBinder Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([householdId])
}

model Task {
  id          String     @id @default(cuid())
  householdId String
  household   Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  title       String
  description String?
  dueDate     DateTime?
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  category    String?
  recurrence  String     @default("NONE")
  assigneeId  String?
  assignee    User?      @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([householdId])
}

model Event {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime?
  allDay      Boolean   @default(false)
  location    String?
  category    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([householdId])
}

model Contact {
  id           String    @id @default(cuid())
  householdId  String
  household    Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name         String
  category     String    @default("OTHER")
  relationship String?
  phone        String?
  email        String?
  address      String?
  notes        String?
  isEmergency  Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([householdId])
}

model Asset {
  id                String    @id @default(cuid())
  householdId       String
  household         Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name              String
  category          String    @default("OTHER")
  brand             String?
  model             String?
  serialNumber      String?
  purchaseDate      DateTime?
  purchasePrice     Float?
  warrantyExpiresAt DateTime?
  location          String?
  notes             String?
  receiptId         String?
  receipt           Receipt?  @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([householdId])
}

model Receipt {
  id            String        @id @default(cuid())
  householdId   String
  household     Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  merchant      String
  purchaseDate  DateTime
  total         Float
  tax           Float?
  category      String        @default("OTHER")
  paymentMethod String?
  fileUrl       String?
  notes         String?
  source        String        @default("MANUAL")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  items         ReceiptItem[]
  assets        Asset[]

  @@index([householdId, purchaseDate])
}

model ReceiptItem {
  id             String  @id @default(cuid())
  receiptId      String
  receipt        Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  name           String
  quantity       Float   @default(1)
  price          Float
  category       String  @default("OTHER")
  hsaEligible    Boolean @default(false)
  warrantyMonths Int?
}

model EmergencyEntry {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  section     String
  title       String
  content     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([householdId])
}

